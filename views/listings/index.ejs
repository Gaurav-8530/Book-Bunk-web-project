<% layout("/layouts/boilerplate") %>

  <style>
    #filters {
      scrollbar-width: none;
    }

    #filters::-webkit-scrollbar {
      display: none;
    }

    .filter {
      min-width: 90px;
      transition: 0.2s;
    }

    .filter:hover {
      opacity: 0.7;
      cursor: pointer;
    }

    .tax-info {
      display: none;
    }
  </style>

  <!-- FILTERS -->
  <div class="container mt-3">
    <div class="d-flex overflow-auto gap-4 align-items-center" id="filters">
      <div class="filter text-center">
        <i class="fa-solid fa-fire fs-5"></i>
        <p class="small mb-0">Trending</p>
      </div>
      <div class="filter text-center">
        <i class="fa-solid fa-mountain fs-5"></i>
        <p class="small mb-0">Mountains</p>
      </div>
      <div class="filter text-center">
        <i class="fa-solid fa-mountain-city fs-5"></i>
        <p class="small mb-0">Cities</p>
      </div>
      <div class="filter text-center">
        <i class="fa-brands fa-fort-awesome fs-5"></i>
        <p class="small mb-0">Castles</p>
      </div>
      <div class="filter text-center">
        <i class="fa-solid fa-person-swimming fs-5"></i>
        <p class="small mb-0">Pools</p>
      </div>
      <div class="filter text-center">
        <i class="fa-solid fa-tree fs-5"></i>
        <p class="small mb-0">Forest</p>
      </div>
      <div class="filter text-center">
        <i class="fa-solid fa-industry fs-5"></i>
        <p class="small mb-0">Mansion</p>
      </div>
      <div class="filter text-center">
        <i class="fa-solid fa-torii-gate fs-5"></i>
        <p class="small mb-0">Desert</p>
      </div>
      <div class="filter text-center">
        <i class="fa-solid fa-campground fs-5"></i>
        <p class="small mb-0">Camping</p>
      </div>
      <div class="filter text-center">
        <i class="fa-solid fa-cow fs-5"></i>
        <p class="small mb-0">Farms</p>
      </div>
      <!-- TAX TOGGLE -->
      <div class="filter text-center">
        <div class="form-check form-switch">
          <input class="form-check-input" type="checkbox" id="switchCheckDefault">
          <label class="form-check-label small" for="switchCheckDefault">
            Show GST
          </label>
        </div>
      </div>
    </div>
  </div>

  <!-- LISTINGS -->
  <div class="container mt-4">
    <div class="row g-4">
      <% for(let list of allListing){ %>
        <div class="col-12 col-sm-6 col-md-4 col-lg-3">
          <a href="/listings/<%= list._id %>" class="text-decoration-none text-dark">
            <div class="card h-100 shadow-sm border-0">
              <img src="<%= list.image.url %>" class="card-img-top" style="height: 200px; object-fit: cover;"
                alt="listing_img">
              <div class="card-body">
                <p class="card-text mb-1">
                  <strong>
                    <%= list.title %>
                  </strong>
                </p>
                <p class="mb-0">
                  ₹ <%= list.price.toLocaleString("en-IN") %> / night
                    <span class="tax-info text-muted small"> +18% GST</span>
                </p>
              </div>
            </div>
          </a>
        </div>
        <% } %>
    </div>
  </div>
  <script>
    let taxSwitch = document.getElementById("switchCheckDefault");
    taxSwitch.addEventListener("click", () => {
      let taxInfo = document.getElementsByClassName("tax-info");
      for (let info of taxInfo) {
        info.style.display = (info.style.display === "inline") ? "none" : "inline";
      }
    });
  </script>